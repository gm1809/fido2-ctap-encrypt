#!/usr/bin/env bash
# .git/hooks/pre-commit
# Encrypts files with filter=crypt before committing, in place (no .enc rename)
# Uses $FIDO2_PIN if set; otherwise asks via pinentry (no disk caching).

set -euo pipefail

get_pin() {
  # 1) use env if present
  if [[ -n "${FIDO2_PIN:-}" ]]; then
    printf '%s' "$FIDO2_PIN"
    return 0
  fi
  # 2) fallback: pinentry (not stored on disk)
  local pin
  pin=$(pinentry-gtk-2 --title "FIDO2 PIN" --description "Bitte gib deinen FIDO2-PIN ein." <<'EOF' \
    | awk -F'^D ' '/^D /{print $2}'
GETPIN
EOF
) || true
  [[ -n "$pin" ]] || return 1
  # make it available to child processes of this hook
  export FIDO2_PIN="$pin"
  printf '%s' "$FIDO2_PIN"
}

# Collect staged files (A/C/M) that have filter=crypt
declare -a FILES_TO_ENCRYPT=()
while IFS= read -r -d '' p; do
  if git check-attr filter -- "$p" 2>/dev/null | grep -q 'filter: crypt'; then
    FILES_TO_ENCRYPT+=("$p")
  fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)

# Nothing to do?
((${#FILES_TO_ENCRYPT[@]})) || exit 0

echo "[pre-commit] Encrypting files…"

PIN="$(get_pin || true)"
if [[ -z "${PIN:-}" ]]; then
  echo "[pre-commit] No PIN provided, aborting commit." >&2
  exit 1
fi

RESTAGE_NEEDED=false
umask 077

for file in "${FILES_TO_ENCRYPT[@]}"; do
  if [[ -f "$file" ]]; then
    echo "[pre-commit] Encrypting: $file"
    tmp="$(mktemp)"
    if ./fido2-derive --mode=enc --pin="$PIN" < "$file" > "$tmp"; then
      mv -f -- "$tmp" "$file"
      git add -- "$file"
      RESTAGE_NEEDED=true
    else
      echo "[pre-commit] Failed to encrypt $file" >&2
      rm -f -- "$tmp"
      exit 1
    fi
  fi
done

$RESTAGE_NEEDED && echo "[pre-commit] Files encrypted and re-staged."
exit 0

